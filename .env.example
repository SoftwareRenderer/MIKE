# Copy to .env and fill in. `.env` is gitignored; this file is the template.
#   cp .env.example .env
#
# The REQUIRED value below has no default on purpose: compose.yaml refuses to render without
# it, because an empty encryption key is a security setting silently doing nothing.

# ── Required ─────────────────────────────────────────────────────────────────

# Encrypts stored provider API keys and derives nothing else. Generate:  openssl rand -hex 32
# Changing it makes stored secrets undecryptable — set it once, keep it.
MIKE_ENCRYPTION_KEY=

# There is no login password to set: a browser signs in with a passkey. The first boot of a
# new data directory prints a one-time pairing code, boxed, to its log — `docker compose
# logs mike` — and it buys exactly one passkey registration. Lost every passkey? Stop the
# server and run `mike --reset-passkeys` against this data directory.

# ── Optional: what the browser reaches ───────────────────────────────────────

# Extra Host header values to accept, comma-separated, ports stripped on both sides.
# Unset or empty means "localhost", which is all you need to browse by https://localhost:3000:
# localhost / 127.0.0.1 / ::1 and the listen host are accepted whether or not they are listed.
# Anything else — a proxy's public domain, hostname.local, a LAN IP — gets HTTP 421 until it is
# named here, and that is the point: this list is the DNS-rebinding guard, so widening it stays a
# decision someone made. Generate-nothing, this is a list you type:
#   e.g. kanban.example.com,192.168.1.20
# MIKE_ALLOWED_HOSTS=localhost

# Host address the port is published on. 127.0.0.1 keeps it on this machine, which is the
# default in compose.yaml. Set 0.0.0.0 to answer the LAN — then MIKE_ALLOWED_HOSTS must name
# the hostname/IP people type, and TLS stays on (the certificate is signed by this server's
# own CA in the data volume; import data/tls/mike-ca.crt or accept the warning).
# MIKE_PUBLISH_ADDRESS=127.0.0.1
# MIKE_PUBLISH_PORT=3000
# MIKE_PORT=3000

# ── Optional: deployment shape ───────────────────────────────────────────────

# Only behind a reverse proxy you control that sets X-Forwarded-For / X-Forwarded-Proto.
# Ignored when unset, so the headers cannot be spoofed to it.
# MIKE_TRUST_PROXY=1

# Set both variables to serve your own certificate pair instead of the leaf this server signs with
# its local CA. Setting one alone stops the boot, and the files must be mounted into the container.
# MIKE_TLS_CERT=/etc/tls/mike.crt
# MIKE_TLS_KEY=/etc/tls/mike.key

# Login attempts per client IP per minute. Cannot be turned off — 0 or garbage falls back to 5
# with a startup warning.
# MIKE_LOGIN_RATE_LIMIT=5

# Extension registry index. Unset = https://registry.getmike.dev/registry.json
# A path with no scheme is read as a local file.
# MIKE_REGISTRY_URL=https://registry.getmike.dev/registry.json

# Pull the default sandbox base image (docker.io/library/ubuntu:latest) at boot instead of
# during the first task that needs it.
# MIKE_PREPULL_IMAGE=1

# ── Optional: build-time ─────────────────────────────────────────────────────

# The tag that `compose build` gives the image.
# MIKE_IMAGE_TAG=local

# The release tag compiled into the image. The server reports it as docker-<tag>, so a build of v0.1.1
# answers docker-v0.1.1. Compose cannot run git, so set this value when the build should name its
# release. Unset, the server reports only docker. `make image` reads the same value from git by itself.
# MIKE_VERSION=v0.1.1

# gVisor release to install in the image: "latest", or a release spelled as its bare date such as
# 20260928 — the bucket path already carries the word `release`, so "release-20260928" is a 404. The
# published sha512 is verified before runsc is ever executed.
# GVISOR_RELEASE=latest

# ── Optional: where your repositories live ───────────────────────────────────

# Host directory bind-mounted to /mike/projects, which is where projects must exist for the
# server to see them and for their .git to reach the sandboxes. Default: ./projects next to
# compose.yaml. Point it at a directory you are willing to have agents edit and commit into —
# not your home directory.
# MIKE_WORKSPACE_DIR=./projects
