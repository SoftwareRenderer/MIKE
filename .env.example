# Copy to .env and fill in. `.env` is gitignored; this file is the template.
#   cp .env.example .env
#
# The three REQUIRED values below have no defaults on purpose: compose.yaml refuses to
# render without them, because a defaulted master password or an empty Host allowlist is a
# security setting silently doing nothing.

# ── Required ─────────────────────────────────────────────────────────────────

# Encrypts stored provider API keys and derives nothing else. Generate:  openssl rand -hex 32
# Changing it makes stored secrets undecryptable — set it once, keep it.
MIKE_ENCRYPTION_KEY=

# The master password for the web UI (and every session). Must be at least 8 characters and
# not a known default: the server refuses to start with a weak one on a non-loopback listen
# address, and inside the container it always listens on 0.0.0.0. Generate:  openssl rand -base64 24
MIKE_LOGIN_PASSWORD=

# Comma-separated Host header values to accept, ports stripped on both sides.
# localhost / 127.0.0.1 / ::1 and the listen host are accepted without listing them; anything
# else — a proxy's public domain, hostname.local, a LAN IP — gets HTTP 421 until it is here.
# So: browse by https://localhost:3000 and "localhost" is enough; behind kanban.example.com,
# put that name here. Generate-nothing, this is a list you type:
#   e.g. localhost,kanban.example.com
MIKE_ALLOWED_HOSTS=

# ── Optional: what the browser reaches ───────────────────────────────────────

# Host address the port is published on. 127.0.0.1 keeps it on this machine, which is the
# default in compose.yaml. Set 0.0.0.0 to answer the LAN — then MIKE_ALLOWED_HOSTS must name
# the hostname/IP people type, and TLS stays on (the certificate is signed by this server's
# own CA in the data volume; import data/tls/mike-ca.crt or accept the warning).
# MIKE_PUBLISH_ADDRESS=127.0.0.1
# MIKE_PUBLISH_PORT=3000
# MIKE_PORT=3000

# ── Optional: deployment shape ───────────────────────────────────────────────

# Only behind a reverse proxy you control that sets X-Forwarded-For / X-Forwarded-Proto.
# Ignored when unset, so the headers cannot be spoofed to it.
# MIKE_TRUST_PROXY=1

# Login attempts per client IP per minute. Cannot be turned off — 0 or garbage falls back to 5
# with a startup warning.
# MIKE_LOGIN_RATE_LIMIT=5

# Extension registry index. Unset = https://getmike.dev/extensions/registry.json
# A path with no scheme is read as a local file.
# MIKE_REGISTRY_URL=https://getmike.dev/extensions/registry.json

# Pull the default sandbox base image (docker.io/library/ubuntu:latest) at boot instead of
# during the first task that needs it.
# MIKE_PREPULL_IMAGE=1

# ── Optional: build-time ─────────────────────────────────────────────────────

# Image tag built by `compose build`, and the version string stamped into the binary.
# MIKE_IMAGE_TAG=local
# MIKE_VERSION=compose

# gVisor release to install in the image: "latest" or a pinned channel/date such as
# release-20250801. The published sha512 is verified before runsc is ever executed.
# GVIZOR_RELEASE=latest

# ── Optional: where your repositories live ───────────────────────────────────

# Host directory bind-mounted to /mike/projects, which is where projects must exist for the
# server to see them and for their .git to reach the sandboxes. Default: ./projects next to
# compose.yaml. Point it at a directory you are willing to have agents edit and commit into —
# not your home directory.
# MIKE_WORKSPACE_DIR=./projects

# Set to 1 to let the add-project directory picker (and its mkdir, git init and clone target)
# reach any host path. Unset, that picker is jailed to the server's home directory plus the
# workspace directory above and MIKE's own extensions directory — /root, /mike/projects and the
# extensions folder in here — and any other path gets a refusal naming this variable. Only the
# exact value 1 widens it: true, yes and 0 keep the jail, and a set-but-not-1 value logs a
# startup warning so the typo is visible. It never widens a project-scoped file request.
# MIKE_ALLOW_ROOT_FS=1
