{
    "display_name": "GitHub Issue Importer",
    "description": "Automatically imports GitHub issue content when a relevant URL is pasted into task description.",
    "author": "SoftwareRenderer",
    "homepage": "https://github.com/SoftwareRenderer",
    "version": "1.0.0",
    "capabilities": {
        "ui": {
            "injection_points": ["createTask"],
            "permissions": [
                "createTask.description.insertText",
                "createTask.events.paste",
                "network.proxy",
                "ui.status"
            ]
        },
        "proxy": {
            "allowed_domains": ["api.github.com"],
            "headers": {
                "Authorization": "token {{github_token}}"
            }
        }
    },
    "config_schema": {
        "properties": [
            {
                "key": "github_token",
                "type": "string",
                "title": "GitHub Personal Access Token",
                "description": "Used to fetch public/private GitHub issue content. Leave empty for public issues.",
                "sensitive": true
            }
        ]
    }
}
