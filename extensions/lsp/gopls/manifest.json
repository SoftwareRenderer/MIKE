{
    "display_name": "Go Language Server",
    "description": "Go language server (gopls) by Google. Provides completions, hover, diagnostics, go-to-definition, and more for Go projects.",
    "author": "Go Team",
    "homepage": "https://github.com/golang/tools/tree/master/gopls",
    "license_url": "https://github.com/golang/tools/blob/master/LICENSE",
    "version": "1.0.0",
    "config_schema": {
        "properties": [
            {
                "key": "memory_limit",
                "type": "number",
                "title": "Memory Limit (MB)",
                "description": "Maximum memory for the gopls sandbox",
                "default": 256
            }
        ],
        "required": []
    },
    "capabilities": {
        "lsp": {
            "command": "gopls",
            "args": ["serve"],
            "extensions": ["go"],
            "language": "go",
            "initParamsOverride": {
                "hover": {
                    "actions": {
                        "enabled": true
                    }
                },
                "codeLens": {
                    "disable": ["generated_test"]
                },
                "hints": {
                    "assignVariableType": true,
                    "compositeLiteralFields": true,
                    "constantValues": true,
                    "functionTypeParameters": true,
                    "parameterNames": true
                },
                "usePlaceholders": true,
                "staticcheck": true
            }
        }
    }
}
