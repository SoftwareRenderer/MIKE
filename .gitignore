node_modules
data/
.env
/projects/
__pycache__/
# The installed-extension tree is pulled state; only its README ships in the release package.
# (`!` cannot reach through an excluded directory, hence the `*` form.)
/extensions/*
!/extensions/README.md
# Build output; the placeholder lets `go:embed` of the SPA compile on a tree that never ran npm.
frontend/dist/*
!frontend/dist/.gitkeep
# Release archives (make package)
/dist/
frontend/stats.html
frontend/stats.json
worktrees/*
frontend/test-results
test-results
test-results2
.worktrees/*
# The bundled skill root ships one tracked package: plan-first, which the executor's plan route and the
# mock LLM both key off. The `*` matters because git does not descend into an excluded directory, so a
# `!` rule under a bare `prompts/skills/` exclusion would never be read.
prompts/skills/*
!prompts/skills/plan-first/
